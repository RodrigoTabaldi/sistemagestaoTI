@model LoginViewModel
@{
    Layout = "_LayoutAutenticacao";
    ViewData["Titulo"] = "Entrar";
    var autoCadastro = ViewData["AutoCadastro"] as bool? ?? false;
}

<main class="tela-acesso">
    <div class="tela-acesso__caixa">
        <header class="tela-acesso__marca">
            <img class="tela-acesso__logo" src="~/img/logo-elcop.png" alt="ELCOP" />
            <p class="tela-acesso__assinatura">Gestão de TI</p>
        </header>

        <h1 class="tela-acesso__titulo">Entrar</h1>
        <p class="tela-acesso__apoio">Use suas credenciais corporativas.</p>

        <form asp-action="Entrar" method="post" novalidate>
            <input type="hidden" asp-for="UrlRetorno" />

            <div asp-validation-summary="ModelOnly" class="alerta alerta--critico mb-3"
                 role="alert" style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")">
                <svg viewBox="0 0 24 24"><use href="#i-alerta" /></svg>
                <div class="validation-summary-errors crescer"></div>
            </div>

            <div class="campo mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="entrada" type="email" autocomplete="username"
                       placeholder="seu.nome@@elcop.com.br" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="campo mb-3">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" class="entrada" type="password" autocomplete="current-password"
                       placeholder="••••••••" />
                <span asp-validation-for="Senha"></span>
            </div>

            <label class="caixa-marcacao mb-4">
                <input asp-for="Lembrar" type="checkbox" />
                <span>Manter-me conectado neste computador</span>
            </label>

            <button type="submit" class="btn btn--primario btn--bloco">
                <svg viewBox="0 0 24 24"><use href="#i-entrada" /></svg> Entrar
            </button>
        </form>

        @if (Model.Firebase is not null)
        {
            <div class="separador-ou">ou</div>

            <form asp-action="EntrarFirebase" method="post" id="form-firebase">
                <input type="hidden" name="idToken" id="firebase-token" />
                <input type="hidden" name="urlRetorno" value="@Model.UrlRetorno" />

                <button type="button" class="btn btn--contorno btn--bloco" id="btn-google">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4z" />
                        <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.7-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z" />
                        <path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14z" />
                        <path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8C16.9 3 14.7 2 12 2a10 10 0 0 0-8.9 5.4L6.4 10c.8-2.4 3-4.1 5.6-4.1z" />
                    </svg>
                    Entrar com o Google
                </button>
            </form>
        }

        @if (autoCadastro)
        {
            <p class="tela-acesso__rodape">
                Ainda não tem acesso? <a asp-action="Registrar">Criar conta</a>
            </p>
        }
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.Firebase is not null)
    {
        <script type="module">
            import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
            import { getAuth, GoogleAuthProvider, signInWithPopup }
                from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

            const app = initializeApp({
                apiKey: "@Model.Firebase.ApiKey",
                authDomain: "@Model.Firebase.AuthDomain",
                projectId: "@Model.Firebase.ProjectId"
            });

            const botao = document.getElementById("btn-google");
            const formulario = document.getElementById("form-firebase");
            const campoToken = document.getElementById("firebase-token");

            botao.addEventListener("click", async () => {
                botao.disabled = true;
                try {
                    // O ID token é validado no servidor; o navegador nunca decide quem entrou.
                    const credencial = await signInWithPopup(getAuth(app), new GoogleAuthProvider());
                    campoToken.value = await credencial.user.getIdToken();
                    formulario.submit();
                } catch (erro) {
                    botao.disabled = false;
                    if (erro.code !== "auth/popup-closed-by-user" && erro.code !== "auth/cancelled-popup-request") {
                        window.Elcop?.notificar?.("Não foi possível entrar com o Google.", "erro");
                        console.error(erro);
                    }
                }
            });
        </script>
    }
}
