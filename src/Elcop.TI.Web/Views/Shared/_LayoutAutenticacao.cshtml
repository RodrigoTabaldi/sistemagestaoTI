<!DOCTYPE html>
<html lang="pt-BR" data-tema="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#8B1F26" />
    <title>@ViewData["Titulo"] · ELCOP Gestão de TI</title>
    <link rel="icon" href="~/img/logo-elcop.png" />
    <link rel="preload" href="~/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/elcop.css" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem("elcop.tema");
            if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "escuro" : "claro";
            document.documentElement.setAttribute("data-tema", t);
        })();
    </script>
</head>
<body>
    <partial name="_Icones" />
    @RenderBody()
    <partial name="_Toasts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/elcop.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
