@{
    Layout = "_LayoutAutenticacao";
    ViewData["Titulo"] = "Cadastro enviado";
    var aprovacaoAutomatica = ViewData["AprovacaoAutomatica"] as bool? ?? false;
}

<main class="tela-acesso">
    <div class="tela-acesso__caixa tela-acesso__caixa--centro">
        <header class="tela-acesso__marca">
            <img class="tela-acesso__logo" src="~/img/logo-elcop.png" alt="ELCOP" />
            <p class="tela-acesso__assinatura">Gestão de TI</p>
        </header>

        <span class="tela-acesso__marcador" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26"><use href="#i-check" /></svg>
        </span>

        @if (aprovacaoAutomatica)
        {
            <h1 class="tela-acesso__titulo">Conta criada</h1>
            <p class="tela-acesso__apoio">Você já pode entrar com o e-mail e a senha cadastrados.</p>
        }
        else
        {
            <h1 class="tela-acesso__titulo">Cadastro enviado</h1>
            <p class="tela-acesso__apoio">
                Sua conta foi criada e está aguardando liberação de um administrador.
                Você conseguirá entrar assim que o acesso for aprovado.
            </p>
        }

        <a class="btn btn--primario btn--bloco" asp-action="Entrar">
            <svg viewBox="0 0 24 24"><use href="#i-entrada" /></svg> Ir para o login
        </a>
    </div>
</main>
