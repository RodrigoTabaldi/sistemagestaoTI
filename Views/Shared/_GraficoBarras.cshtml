@model IReadOnlyList<ItemGrafico>
@{
    var maximo = Model.Count == 0 ? 0m : Model.Max(i => i.Valor);
    var paleta = new[] { "#8B1F26", "#A8323A", "#3F6FB5", "#2E9E6B", "#B98A2E", "#C4741C", "#9C2B7A", "#4A5568" };
}

@if (Model.Count == 0)
{
    <p class="texto-tenue pequeno" style="margin:0">Sem dados para exibir.</p>
    return;
}

<div class="grafico-barras">
    @for (var i = 0; i < Model.Count; i++)
    {
        var item = Model[i];
        var percentual = maximo == 0 ? 0 : (double)(item.Valor / maximo) * 100;
        var cor = item.Cor ?? paleta[i % paleta.Length];

        <div class="barra-item">
            <span class="barra-item__rotulo">@item.Rotulo</span>
            <span class="barra-item__valor">@item.Valor.ToString("N0")</span>
            <div class="barra-item__trilho">
                <div class="barra-item__preenchimento" style="--barra-cor:@cor"
                     data-barra="@percentual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"></div>
            </div>
        </div>
    }
</div>
